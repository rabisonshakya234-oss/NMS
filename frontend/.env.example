# Public address of THIS frontend. It must match CLIENT_URL in the backend .env,
# because the backend's CORS only allows that one origin (http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address of the Express API. Start the backend on another port, e.g. PORT=5000.
NEXT_PUBLIC_API_URL=https://nms-10.onrender.com/api
